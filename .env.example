# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=yan_guan

# 数据库连接字符串（生产环境使用）
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@db:5432/yan_guan

# JWT 密钥（必须修改！使用 openssl rand -hex 32 生成）
JWT_SECRET_KEY=change_this_to_a_random_secure_string

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
