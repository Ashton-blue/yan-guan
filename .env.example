# 研管（yan-guan）环境变量示例
# 复制为 .env 使用（.env 已被 .gitignore 忽略，不会进仓库）
# 密钥零硬编码红线：所有密钥/口令一律在此或平台环境变量中配置，禁止把真实值提交进仓库

# ---- 数据库（本地 docker-compose） ----
# Zeabur 生产环境由平台注入真实 DATABASE_URL，此处仅本地默认
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/yan_guan

# ---- 后端应用 ----
# JWT 签名密钥：必须为长随机串且非空（openssl rand -hex 32 生成）。缺失/为空时应用启动会报错拦截。
SECRET_KEY=please-set-a-long-random-jwt-secret
# CORS 允许来源（逗号分隔；生产建议收敛为前端公网域名 https://yan-guan.zeabur.app）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yan-guan.zeabur.app

# ---- DeepSeek（AI 功能可选，不用可留空） ----
DEEPSEEK_API_KEY=your-deepseek-api-key
