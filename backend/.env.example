# 数据库（本地/Compose 默认指向 db:5432；Coze Supabase 部署时由平台注入真实值）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/yan_guan

# ---- 密钥零硬编码：以下为占位符，部署时替换为真实值，禁止把真实密钥提交进仓库 ----
# JWT 签名密钥（必须为长随机串，非空；未设置时应用启动会在 validate() 中报错拦截）
SECRET_KEY=please-set-a-long-random-jwt-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=1
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=*

# DeepSeek（AI 功能可选；不用可留空，不要写死真实 key）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
